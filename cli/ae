#!/usr/bin/env bash
set -euo pipefail

# ae - unified CLI for AE QA Agent infrastructure

AE_VERSION="0.1.0"
AE_HOME="${AE_HOME:-$HOME/.ae}"

_AE_SCRIPT="${BASH_SOURCE[0]}"
while [[ -L "$_AE_SCRIPT" ]]; do
    _AE_DIR="$(cd "$(dirname "$_AE_SCRIPT")" && pwd)"
    _AE_SCRIPT="$(readlink "$_AE_SCRIPT")"
    [[ "$_AE_SCRIPT" != /* ]] && _AE_SCRIPT="$_AE_DIR/$_AE_SCRIPT"
done
AE_CLI_DIR="$(cd "$(dirname "$_AE_SCRIPT")" && pwd)"
AE_LIB_DIR="$AE_CLI_DIR/lib"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m'

info()  { echo -e "${BLUE}[ae]${NC} $*"; }
ok()    { echo -e "${GREEN}[ae]${NC} $*"; }
warn()  { echo -e "${YELLOW}[ae]${NC} $*"; }
err()   { echo -e "${RED}[ae]${NC} $*" >&2; }

usage() {
    cat <<EOF
${BOLD}ae${NC} v${AE_VERSION} - AE QA Agent CLI

${BOLD}USAGE${NC}
    ae <command> [args...]

${BOLD}COMMANDS${NC}
    ${BOLD}qa${NC} <subcommand>       QA 项目入驻与测试工作流
        product-init <dir>             初始化一个产品专属 QA Agent
        start <dir>                    新项目 QA 入驻总入口
        intake-check <dir>             检查测试入驻资料完整性
        onboard <dir>                  生成产品理解包和 QA Memory
        consistency-check <dir>        检查资料冲突和覆盖缺口
        risk-scan <dir>                生成风险地图
        generate-cases <dir>           生成分级测试用例
        change-impact <target>         分析变更影响和回归范围
        file-bugs <report>             结构化整理并提交缺陷
        release-check <dir>            发布前质量门禁判断
        new-module-test <target>       新模块测试任务规划

    ${BOLD}git${NC} <subcommand>      可选的 Gitee API 适配器
        issues list/get/create/comment/list-comments/close/edit/edit-comment
        upload-image --repo REPO --file PATH
        auth validate/user

    ${BOLD}setup${NC} [role]          一键搭建环境
    ${BOLD}install${NC}               安装依赖
    ${BOLD}doctor${NC}                检查环境
    ${BOLD}update${NC}                更新 AE 组件
    ${BOLD}link${NC} <role> [dir]     在项目中启用 AE 能力
    ${BOLD}feedback${NC}              管理使用反馈
    ${BOLD}manifest${NC} <sub> <role> 生成/查看能力清单
    ${BOLD}version${NC}               显示版本
    ${BOLD}help${NC}                  显示帮助

${BOLD}EXAMPLES${NC}
    ae qa product-init ./my-product
    ae qa start ./qa-onboarding-input
    ae qa intake-check ./qa-onboarding-input
    ae qa onboard .
    ae qa risk-scan .
    ae qa generate-cases .
    ae qa change-impact "git diff main...HEAD"
    ae qa new-module-test ./docs/new-module-prd.md
EOF
}

source_lib() {
    local lib="$AE_LIB_DIR/$1.sh"
    if [[ ! -f "$lib" ]]; then
        err "缺少模块: $lib"
        exit 1
    fi
    source "$lib"
}

main() {
    if [[ $# -eq 0 ]]; then
        usage
        exit 0
    fi

    local cmd="$1"
    shift

    case "$cmd" in
        qa)
            source_lib "qa/commands"
            ae_qa "$@"
            ;;
        setup)
            source_lib "setup"
            ae_setup "$@"
            ;;
        install)
            source_lib "install"
            ae_install "$@"
            ;;
        doctor)
            source_lib "doctor"
            ae_doctor "$@"
            ;;
        update)
            source_lib "update"
            ae_update "$@"
            ;;
        git)
            local ae_git="$(dirname "$AE_CLI_DIR")/scripts/ae-git.py"
            if [[ ! -f "$ae_git" ]]; then
                err "ae-git.py 未找到: $ae_git"
                exit 1
            fi
            python3 "$ae_git" "$@"
            ;;
        link)
            source_lib "link"
            ae_link "$@"
            ;;
        feedback)
            source_lib "feedback"
            ae_feedback "$@"
            ;;
        manifest)
            source_lib "manifest"
            ae_manifest "$@"
            ;;
        version|--version|-v)
            echo "ae v${AE_VERSION}"
            ;;
        help|--help|-h)
            usage
            ;;
        *)
            err "未知命令: $cmd"
            echo ""
            usage
            exit 1
            ;;
    esac
}

main "$@"
