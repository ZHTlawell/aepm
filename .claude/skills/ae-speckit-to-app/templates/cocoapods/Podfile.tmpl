# 付费墙 base — 子类见 templates/purchase/BCPurchaseUIBase.swift.tmpl
def basevip
  pod "BCPurchaseBasicUI", :git => "#{GITLAB_BASE_URL}/bc_purchase_basic_ui.git", :tag => "1.5.1"
end

# 付费墙皮肤分支
# bible-app 踩坑 F4：默认模板引用 plant/07 会显示植物主题，必须改为本产品分支
# 方案 A: 让龙哥创建 {{PRODUCT_NAME_LOWER}}/07 分支
# 方案 B: 不加载皮肤，纯靠 PurchaseUI{{MEMO}}ViewController 子类覆盖（推荐）
def vip
  pod "BCPurchaseUI_07", :git => "#{GITLAB_BASE_URL}/bc_purchaseui.git", :branch => "{{VIP_BRANCH}}"
  # 例: branch => "bible/07"
end

target "Template" do
  thirdlib
  debug
  components
  basevip
  vip
  local
end

post_install do |installer|
  installer.generated_projects.each do |project|
    project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings["CODE_SIGN_IDENTITY"] = ""
        if config.build_settings["IPHONEOS_DEPLOYMENT_TARGET"].to_f < 15.0
          config.build_settings["IPHONEOS_DEPLOYMENT_TARGET"] = "15.0"
        end
      end
    end
  end
end
