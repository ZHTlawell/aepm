source "https://cdn.cocoapods.org"

platform :ios, "15.0"       # TS-003
use_frameworks!
inhibit_all_warnings!

# TS-002: 必须同时配置 V1 + V2 两个私有源
GITLAB_BASE_URL = "https://gitlab.bytescell.net/components/ios/2.0"
GITLAB_LocalPath = "../../Components/2.0"

GITLAB_BASE_URLV1 = "https://gitlab.bytescell.net/components/ios"
GITLAB_LocalPathV1 = "../../Components"

ENV["COCOAPODS_TIMEOUT"] = "600"

# 第三方（公开 CocoaPods）
def thirdlib
  pod "SnapKit",                      "5.7.1"
  pod "CTMediator",                   "48"
  pod "IQKeyboardManager",            "6.5.19"
  pod "lottie-ios",                   "4.5.2"
  pod "Toast-Swift",                  "~> 5.1.1"
  pod "SKPhotoBrowser",               "7.1.0"
  pod 'Popovers',                     "1.3.0"
  pod 'MJRefresh',                    "3.7.9"
end

# 本地业务 Pod — TS-004
def local
  pod "AppImports",         :path => "Locals/AppImports"
  pod "AppModels",          :path => "Locals/AppModels"
  pod "AppRepository",      :path => "Locals/AppRepository"
  pod "DeleteAccountPage",  :path => "Locals/DeleteAccountPage"
  pod "BCConfig",           :path => "Locals/BCConfig"
  pod "AppSettings",        :path => "Locals/AppSettings"
  pod "Welcome_01",         :path => "Locals/Welcome_01"
  pod "Welcome_02",         :path => "Locals/Welcome_02"
  pod "Welcome",            :path => "Locals/Welcome"
  pod "BCCameraController", :path => "Locals/BCCameraController"
  pod "BCAppSearch",        :path => "Locals/BCAppSearch"
  # 业务模块 — 按产品替换
  pod "{{PRODUCT_NAME}}",   :path => "Locals/{{PRODUCT_NAME}}"
end

# Debugger（V2 私有源）
def debug
  pod "BCDebuggerExtension", :git => "#{GITLAB_BASE_URL}/bc_debugger_extension.git"
  pod "BCDebugger",          :git => "#{GITLAB_BASE_URL}/bc_debugger.git",           :tag => '1.0.0', :configurations => ['Debug']
  pod "BCAnalyticsDebugger", :git => "#{GITLAB_BASE_URL}/bc_analytics_debugger.git", :tag => '1.0.1', :configurations => ['Debug']
end

