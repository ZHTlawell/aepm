import Foundation
import BCUtils

class UserInitWork: WorkVoidCallbackTask {
    func work(_ callback: @escaping VoidCallback) {
        #if DEBUG
        if ProcessInfo.processInfo.environment["DEBUG_SKIP_USERINIT"] == "1" {
            callback()
            return
        }
        #endif
        LaunchTransitionViewController.show(title: BCConsts.appName, completion: callback)
    }
}
