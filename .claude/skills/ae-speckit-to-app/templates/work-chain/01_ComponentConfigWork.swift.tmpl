import Foundation
import BCUtils
import BCNetwork
import BCSensor
import BCWebImage
import BCConfig
import IQKeyboardManager
import BCPurchaseBasicUI
import BCWidget
import LegalPrompt
import SKPhotoBrowser
import Toast_Swift
import BCStoreKit
import BCCache
import BCConfigExtension
import CTMediator
import AppSettings
import AppGroupCore
import BCCameraController
import Kingfisher
import AppModels
import BCFeedback
import AppImports
import BCAssetKit
import MJRefresh

class ComponentConfigWork: WorkVoidCallbackTask, BCPurchaseUIServiceProtocol {
    private let appsettingsOwner = AppSettingsOwner()
    private let cameraDelegate = BCCameraDelegate()
    var loadingManager: BCPurchaseUILoadingProtocol? { nil }

    init() {
        NotificationCenter.default.addObserver(forName: .appLanguageChanged, object: nil, queue: .main) { [weak self] _ in
            self?.configMJRefresh()
        }
    }

    func work(_ callback: @escaping VoidCallback) {
        configCache()
        configMJRefresh()
        configLocalization()
        configAssetKit()
        configNetwork()
        configTrack()
        configWebImage()
        configAppearanceUI()
        configPurchaseUI()
        configSKPhotoBrowser()
        configToast()
        configTabBar()
        configStoreKit()
        configSettings()
        configCamera()
        configFeedback()

        _ = OperationManager.shared
        UIDevice.prepareFeedbackGenerator()
        HDImagesManager.shared.uploadAll()
        BCBaseViewController.swizzleWiewWillBeRemoved()
        callback()
    }

    private func configMJRefresh() {
        MJRefreshConfig.default.languageCode = BCAppLanguage.app.localizationCode
    }

    private func configLocalization() { BCLocalization.initLocalization() }

    private func configAssetKit() { BCAssetKit.setUIColor(.bc_color(0x1A1412)) }

    private func configCache() {
        if CT().BCConfig_currentEnvironmentIsStage() { BCCache.prefix = "stage" }
    }

    private func configNetwork() {
        BCNetworkReachabilityTool.startListening { _, _ in }
        // stage 关闭加密方便联调，prod 保留
        if BCConfig.env != .prod { BCNetworkCypher.enable = false }
    }

    private func configTrack() { BCTrack.setup() }

    private func configWebImage() {
        let manager = BCWebImage.shared
        manager.setDefaultPlaceholder(.init(named: "common_placeholder_icon"),
                                      size: .init(width: 80.fx, height: 80.fx),
                                      backgrouindColor: .bc_color(0xE9E9E9),
                                      contentMode: .center)
        manager.setMaxCachePeriod(Int.bc_day * 30)
        manager.initAWS(bucket: BCConfig.awsBucket, host: BCConfig.awsHost)
        manager.cacheKeyCallback = { urlString, cacheKey in
            HDImagesManager.shared.cacheKeysWillRemoved(url: urlString, cachedKey: cacheKey)
        }
    }

    private func configAppearanceUI() {
        BCResponsiveLayout.ipadZoomScale = 1.0
        UIFont.isEnableBCFontZoom = false
        IQKeyboardManager.shared().isEnabled = true
        IQKeyboardManager.shared().shouldResignOnTouchOutside = true
        BCPurchaseUIManager.purchaseService = self
        UITableView.appearance().sectionHeaderTopPadding = 0
        UITextView.appearance().tintColor = .main
        UITextField.appearance().tintColor = .main
    }

    private func configPurchaseUI() {
        // TODO: 替换为本产品的 legal 页面 URL
        BCPurchaseUIManager.termOfUsHandler = {
            if let url = URL(string: "https://{{LEGAL_HOST}}/terms-of-use.html") {
                UIApplication.shared.open(url)
            }
        }
        BCPurchaseUIManager.privacyPolicyHandler = {
            if let url = URL(string: "https://{{LEGAL_HOST}}/privacy-policy.html") {
                UIApplication.shared.open(url)
            }
        }
    }

    private func configSKPhotoBrowser() {
        SKCache.sharedCache.imageCache = SKPhotoBrowserCache()
        SKPhotoBrowserOptions.longPhotoWidthMatchScreen = true
    }

    private func configToast() {
        var style = ToastStyle()
        style.imageSize = .init(width: 16.0, height: 16.0)
        style.backgroundColor = .bc_color(0x050505, alpha: 0.8)
        style.titleColor = .white
        style.titleFont = .medium(14.fx)
        style.verticalPadding = 14.fx
        style.cornerRadius = 16.fx
        style.shadowColor = .bc_color(0xff0000)
        style.shadowOpacity = 0.12
        style.shadowRadius = 32.fx
        style.shadowOffset = .init(width: 0, height: 4.fx)
        style.displayShadow = true
        BCToast.set(style: .init(style: style))
    }

    private func configTabBar() {
        if #available(iOS 18, *), IsIPad {
            UIViewController.swizzleViewWillLayoutSubviews()
        }
    }

    private func configStoreKit() {
        BCStoreKit.initial()
        // 必须 eager init Purchase.shared 才会触发 BCStoreKit.setup(SKUConfig.purchaseSkus)
        // 否则首次冷启动付费墙 BCStoreKit.product(of:) 返回 nil，purchaseSubscription 静默失败
        _ = Purchase.shared
    }

    private func configSettings() { AppSettings.shared.delegate = appsettingsOwner }
    private func configCamera() { BCCameraController.shared.delegate = cameraDelegate }

    private func configFeedback() {
        var survey = BCFeedbackTheme.survey
        survey.noButton = .init(text: .init(font: .semibold(16.fx), color: .text(opacity: 0.7)),
                                backgroundColor: .bc_color(0xF7F2EA))
        survey.yesButton = .init(text: .init(font: .semibold(16.fx), color: .white),
                                 backgroundColor: .bc_color(0xAA7227))
        survey.description = .init(font: .medium(18.fx), color: .text())
        survey.backgroundColors = [.bc_color(0xF7F2EA), .bc_color(0xFFFFFF)]
        BCFeedbackTheme.survey = survey
    }
}
