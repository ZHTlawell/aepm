import UIKit
import BCUtils
import BCStoreKit

class AfterLoginWork: WorkVoidCallbackTask {
    func work(_ callback: @escaping VoidCallback) {
        BCStoreKit.checkBegin()
        #if targetEnvironment(simulator)
        #else
        if !IsVIP() {
            BCStoreKit.restore { _ in }
        }
        #endif
        callback()
    }
}
