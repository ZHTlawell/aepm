import Foundation
import CTMediator
import BCStoreKit

@objc public enum AppEnv: Int, CaseIterable, Codable {
    case prod
    case stage
    case test

    var networkSignture: String? { nil }

    public var mainHost: String {
        if let reviewAddress = reviewAddress { return reviewAddress }
        switch self {
        case .prod:  return "https://app.{{PRODUCT_DOMAIN}}"         // 例: app.bible.itemvaults.com
        case .stage: return "https://app-stage.{{PRODUCT_DOMAIN}}"   // 例: app-stage.bible.itemvaults.com
        case .test:  return "http://localhost:8181"                  // 本地调试
        }
    }

    private var reviewAddress: String? { nil }

    var appHost: String { mainHost + "/api" }
}


@objc public class BCConfig: NSObject {
    public class var env: AppEnv {
        #if DEBUG
        return .stage
        #else
        return .prod
        #endif
    }

    // AppInfo — {{PRODUCT_NAME}}
    public static let appId: String = "{{APP_ID}}"                      // ASC App ID
    public static let teamId: String = "{{TEAM_ID}}"                    // Apple Developer Team ID
    public static let appStoreLink = String(format: "https://apps.apple.com/app/id%@", appId)
    public static let appStoreShortLink = "https://apps.apple.com/app/id{{APP_ID}}"
    public static let appStoreReviewLink = String(format: "itms-apps://itunes.apple.com/app/id%@?mt=8&action=write-review", appId)
    public static let supportEmail = "{{SUPPORT_EMAIL}}"                // 例: developer@auroredgetech.com
    public static let supportEmailScheme = "mailto:" + supportEmail
    public static let launchScreenCacheVersion = "0.1.0"
}

// MARK: - Tracking
extension BCConfig {
    static let appProductId: String = "{{PRODUCT_ID}}"                   // 例: bible (tcc name)
    static let sensorsdataServerUrl: String = "{{SENSORS_URL}}"
    static let sensorsABServerUrl: String = "{{SENSORS_AB_URL}}"
}

// MARK: - Adjust
extension BCConfig {
    static let adjustAppToken: String = AdjustToken.sdk.rawValue
    static let adjustTodayPayToken: String = AdjustToken.todaypay.rawValue
    static let adjustShareToken: String = AdjustToken.share.rawValue
    static let adjustEnableTrackingSubscription: Bool = true
}

// MARK: - AWS
extension BCConfig {
    public static let awsBucket = "{{PRODUCT_ID}}-scope"                 // TS-035
    public static let awsHost = "https://static.{{PRODUCT_DOMAIN}}"
    public static let imageMaxCachePeriod: Int = 30 * 24 * 3600
    public static let defaultPlaceholderImage: UIImage? = UIImage(named: "common_placeholder_icon")
    public static let defaultPlaceholderBackgroundColor: UIColor = .bc_color(0x151B2A, alpha: 0.15)
}

public extension BCConfig {
    static func appStoreShortLink(with page: String?) -> String {
        var urlString = self.appStoreShortLink
        if let page { urlString += "?adj_campaign=\(page)" }
        return urlString
    }
}

// TS-010 / BCAdjust 使用
public enum AdjustToken: String {
    case sdk       = "{{ADJUST_TOKEN_SDK}}"
    case todaypay  = "{{ADJUST_TOKEN_TODAYPAY}}"
    case share     = "{{ADJUST_TOKEN_SHARE}}"
    case discount  = "{{ADJUST_TOKEN_DISCOUNT}}"
    case yearly    = "{{ADJUST_TOKEN_YEARLY}}"
    case month     = "{{ADJUST_TOKEN_MONTHLY}}"
    case week      = "{{ADJUST_TOKEN_WEEKLY}}"
    case subscribe = "{{ADJUST_TOKEN_SUBSCRIBE}}"
    case purchase  = "{{ADJUST_TOKEN_PURCHASE}}"
    case cancel    = "{{ADJUST_TOKEN_CANCEL}}"
    case refund    = "{{ADJUST_TOKEN_REFUND}}"
}
